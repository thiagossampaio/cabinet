# Optional: set a password to protect the UI (leave empty for no auth)
KB_PASSWORD=

# Optional: domain for the app
DOMAIN=localhost

# Optional: override the shared data directory.
# Defaults to ./data for source installs, or a managed app-data path in Electron.
# CABINET_DATA_DIR=

# OAuth authentication (better-auth) — leave empty to use KB_PASSWORD only
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Git auto-commit behavior. Set to 'false' to disable auto-commit and use manual Commit/Push buttons.
# Default is enabled (any value other than 'false', or unset).
NEXT_PUBLIC_GIT_AUTO_COMMIT=true

# Optional: release manifest URL for update checks.
# CABINET_RELEASE_MANIFEST_URL=https://github.com/hilash/cabinet/releases/latest/download/cabinet-release.json

# Optional: override runtime ports and origins.
#
# Reverse proxy / TLS termination note:
# - Public origins are what the browser should use.
# - Internal origins are what the Cabinet process should use for self-fetches on the host.
# - Keep these separate when HTTPS is terminated by a proxy and the local app still serves plain HTTP.
#
# Example:
# BETTER_AUTH_URL=https://cabinet.example.com
# CABINET_APP_ORIGIN=https://cabinet.example.com
# CABINET_INTERNAL_APP_ORIGIN=http://127.0.0.1:3000
# CABINET_PUBLIC_DAEMON_ORIGIN=wss://cabinet.example.com
# CABINET_DAEMON_URL=http://127.0.0.1:3001
#
# Electron note: in embedded Electron mode these are usually managed automatically.
# CABINET_APP_PORT=3000
# CABINET_DAEMON_PORT=3001
# CABINET_APP_ORIGIN=http://127.0.0.1:3000
# CABINET_INTERNAL_APP_ORIGIN=http://127.0.0.1:3000
# CABINET_PUBLIC_DAEMON_ORIGIN=ws://127.0.0.1:3001
# CABINET_DAEMON_URL=http://127.0.0.1:3001
